{
    // NOTE: Vetur は VSCode からアンインストール済みなんだよ?
    //       それなのにずっと Vetur が動き続けて鬱陶しいので (なんでだよ)、これ↓を参考にして無効化したよ。
    //       https://stackoverflow.com/questions/64901658/how-do-i-disable-vetur-linting-in-vscode-workspace
    "vetur.validation.template": false,
    "vetur.validation.script": false,
    "vetur.validation.style": false,
    // NOTE: ESLint は flat config (eslint.config.mjs) を使う。保存時に --fix 相当を走らせる。
    "eslint.useFlatConfig": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    }
}
